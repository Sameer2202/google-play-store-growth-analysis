        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='playstore_for_tableau.csv (Multiple Connections)' name='federated.1iahgnh12l9fp215l60ex0cd12ac' />
          </datasources>
          <datasource-dependencies datasource='federated.1iahgnh12l9fp215l60ex0cd12ac'>
            <column caption='Category (sentiment by category.csv)' datatype='string' name='[Category (sentiment_by_category.csv)]' role='dimension' type='nominal' />
            <column caption='Pct Positive' datatype='real' name='[Pct_Positive]' role='measure' type='quantitative' />
            <column-instance column='[Category (sentiment_by_category.csv)]' derivation='None' name='[none:Category (sentiment_by_category.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Pct_Positive]' derivation='Sum' name='[sum:Pct_Positive:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1iahgnh12l9fp215l60ex0cd12ac].[none:Category (sentiment_by_category.csv):nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Pct_Positive])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Category (sentiment_by_category.csv):nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <natural-sort column='[federated.1iahgnh12l9fp215l60ex0cd12ac].[none:Category (sentiment_by_category.csv):nk]' direction='DESC' />
          <slices>
