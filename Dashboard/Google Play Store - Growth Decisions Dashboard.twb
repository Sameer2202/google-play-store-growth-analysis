    <worksheet name='Chart_Sentiment_by_Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Top Categories by Review Sentiment</run>
